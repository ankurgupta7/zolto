<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/warm_white">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="@color/near_black" />

    <!-- TWINT QR: the Stripe redirect URL rendered for the customer to scan. -->
    <ImageView
        android:id="@+id/img_qr"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/twint_scan_prompt"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_card_prompt"
        android:textColor="@color/deep_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.02" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/cancel"
        android:minWidth="120dp"
        style="@style/Widget.Zolto.Button.Outlined" />

</LinearLayout>
