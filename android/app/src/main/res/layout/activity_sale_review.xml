<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/warm_white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/warm_white"
        android:title="@string/sale_review_title"
        style="@style/Widget.Brand.Toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_sale_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txt_custom_items_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="4dp"
                android:text="@string/custom_items_label"
                android:textColor="@color/muted_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_custom_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_custom_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/add_custom_item"
                style="@style/Widget.Brand.Button.Outlined" />

        </LinearLayout>

    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <TextView
        android:id="@+id/txt_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/deep_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_charge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginEnd="4dp"
            android:text="@string/pay_card"
            android:textSize="16sp"
            style="@style/Widget.Brand.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cash"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/pay_cash"
            android:textSize="16sp"
            style="@style/Widget.Brand.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_twint"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:text="@string/pay_twint"
            android:textSize="16sp"
            style="@style/Widget.Brand.Button.Outlined" />

        <!-- Only shown once the merchant has uploaded their TWINT QR sticker
             (GET /api/pos/config → twintQrUrl); hidden otherwise so we never
             offer a rail we can't put on screen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_twint_qr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:text="@string/pay_twint_qr"
            android:textSize="14sp"
            android:visibility="gone"
            style="@style/Widget.Brand.Button.Outlined" />

    </LinearLayout>

</LinearLayout>
