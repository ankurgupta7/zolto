<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warm_white"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/warm_white"
            android:title=""
            app:layout_scrollFlags="scroll|enterAlways">

            <ImageView
                android:id="@+id/img_toolbar_logo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/gwinn_logo"
                android:visibility="visible"
                android:contentDescription="Gwinn Zürich" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/warm_white"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Slim indeterminate bar: visible whenever a DB/network sync runs. -->
        <ProgressBar
            android:id="@+id/progress_sync"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/gold"
            android:visibility="gone" />

        <!-- Offline indicator banner — shown when the device is offline. -->
        <TextView
            android:id="@+id/txt_offline_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warning_orange"
            android:text="@string/offline_cash_only"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="6dp"
            android:visibility="gone" />

        <!-- Pending sync indicator — shown when there are unsynced transactions. -->
        <TextView
            android:id="@+id/txt_pending_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/forest_green"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="6dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:padding="10dp"
            android:background="@color/warm_ivory"
            android:hint="@string/search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:textColor="@color/near_black"
            android:textColorHint="@color/muted_text" />

        <HorizontalScrollView
            android:id="@+id/scroll_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warm_ivory"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true" />

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/layout_discovery_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:background="@color/warm_white">

            <Spinner
                android:id="@+id/spinner_sort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent" />

            <ImageButton
                android:id="@+id/btn_toggle_view"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Toggle view mode"
                app:tint="@color/near_black" />

        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_selection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="8dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Chip.Action" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/near_black"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_products"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/txt_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/muted_text"
                    android:text="@string/products_empty"
                    android:visibility="gone" />

            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_review_sale"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="16dp"
            android:enabled="false"
            android:text="@string/review_sale"
            android:textSize="16sp"
            style="@style/Widget.Brand.Button" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
